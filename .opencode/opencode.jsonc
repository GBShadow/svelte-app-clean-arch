      "npm": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git ls*": "allow",
      "ls *": "allow",
      "touch *": "allow",
      "cat *": "allow"
    },
    "webfetch": "allow"
  }
}
