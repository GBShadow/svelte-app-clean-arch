{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "svelte": {
      "type": "remote",
      "url": "https://mcp.svelte.dev/mcp",
      "enabled": true
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "pnpm": "allow",
      "npm run *": "allow",
      "npm": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git ls*": "allow",
      "ls *": "allow",
      "touch *": "allow",
      "cat *": "allow"
    },
    "webfetch": "allow"
  }
}
